# Re-stage whatever `format:fix` rewrites, so a commit never leaves the formatted
# version behind as a dirty file.
#
# The pathspec matters. `src/**/*.ts` looks like it covers the tree but git's `**`
# requires an intermediate directory, so it matches src/db/foo.ts and NOT src/foo.ts
# — every file directly under src/, which is most of them. Prettier reformatted
# src/claude-md-compose.test.ts on 2026-08-08, the re-add silently matched nothing,
# and the reformat was left uncommitted. Match the directory and filter by suffix.
staged=$(git diff --cached --name-only --diff-filter=ACM -- src | grep -E '\.(ts|tsx|mts|cts)$' || true)
pnpm run format:fix
if [ -n "$staged" ]; then
  # Only files that were already staged. format:fix rewrites all of src/, and
  # sweeping an unrelated file into someone's commit is worse than a dirty tree.
  echo "$staged" | xargs -r git add --
fi

# Parse-gate BOTH shipped trees before anything can be committed.
#
# format:fix above only ever touched src/**, which is how a missing `}` in
# container/agent-runner/src/poll-loop.ts sailed through on 2026-08-03 and
# killed every agent container for three days. That directory is bind-mounted
# read-only at /app/src, so a syntax error there is in production the moment
# it is written — there is no build step to catch it.
#
# Syntax only, so it stays fast and cannot fail for formatting or type reasons.
if ! node scripts/check-syntax.cjs; then
  echo ''
  echo 'pre-commit: BLOCKED — the code above does not parse.'
  echo 'Fix it before committing. To bypass in a genuine emergency: git commit --no-verify'
  exit 1
fi
